COMPOSE_PROJECT_NAME=student-certificate

# Database (local demo only; change before sharing a running instance)
POSTGRES_USER=cert_app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=cert_app
DATABASE_URL=postgresql+psycopg://cert_app:change-me-local-only@postgres:5432/cert_app

# Internal app <-> n8n authentication. Use a long random value locally.
INTERNAL_API_TOKEN=change-me-to-a-random-token
ADMIN_TOKEN=change-me-to-an-admin-token

# n8n local editor. N8N_ENCRYPTION_KEY must remain stable with n8n_data.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-encryption-key
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# Local-only notification sink (Mailpit; no Internet mail is sent).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=phongdaotao@example.local

# Reproducible process-mining defaults.
SIMULATION_SEED=43044
SIMULATION_CASES=120
SIMULATION_SNAPSHOT=2026-09-30T17:00:00Z
OVERDUE_HOURS=48
APP_TIMEZONE=Asia/Ho_Chi_Minh


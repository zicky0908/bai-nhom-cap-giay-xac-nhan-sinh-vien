  <bpmn:collaboration id="Collab_asis">
    <bpmn:participant id="Pool_asis" name="AS-IS: cấp giấy xác nhận sinh viên (giả định)" processRef="Proc_asis" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_asis" isExecutable="false">
    <bpmn:laneSet id="LaneSet_asis">
      <bpmn:lane id="L1_asis" name="L1 Sinh viên">
        <bpmn:flowNodeRef>S0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2_asis" name="L2 Cán bộ CTHSSV">
        <bpmn:flowNodeRef>A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3_asis" name="L3 Lãnh đạo phòng">
        <bpmn:flowNodeRef>A07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L4_asis" name="L4 Văn thư">
        <bpmn:flowNodeRef>A08</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S0" name="Cần giấy xác nhận">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="A01" name="A01 Nộp yêu cầu (đơn giấy/form)">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A02" name="A02 Tiếp nhận, ghi sổ, gán số">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A03" name="A03 Kiểm tra thông tin và tư cách">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G1" name="Kết quả kiểm tra?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A04" name="A04 Báo SV bổ sung (mục thiếu, hạn)">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:eventBasedGateway id="G3" name="Chờ SV hoặc hết hạn">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="A05" name="A05 SV nộp bổ sung">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MD_A05" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="T1" name="Hết hạn 7 ngày LV (phát hiện khi rà thứ Sáu)">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_T1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="A13" name="A13 Đóng hồ sơ quá hạn, báo SV">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E3" name="E3 Đóng do quá hạn">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="A06" name="A06 Soạn giấy và phiếu trình">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A07" name="A07 Xem xét, quyết định, ký">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G2" name="Quyết định?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A08" name="A08 Đóng dấu, vào sổ">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A10" name="A10 Ghi lý do từ chối">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A09" name="A09 Xác nhận đã cấp">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A11" name="A11 Báo SV có giấy, hẹn nhận">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A14" name="A14 Báo SV bị từ chối kèm lý do">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E2" name="E2 Bị từ chối">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="A12" name="A12 SV nhận giấy">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E1" name="E1 Đã nhận giấy">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
